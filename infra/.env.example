# --- General ---
APP__ENV=local
SECURITY__SECRET_KEY=CHANGE-ME
APP__PUBLIC_BASE_URL=http://localhost:8000

# --- Database ---
DB__USER=postgresql
DB__PASSWORD=CHANGE-ME
DB__NAME=recipes
DB__PORT=5432

# --- Redis ---
REDIS__PASSWORD=CHANGE-ME
REDIS__PORT=6379

# --- User session (optional: defaults suit local development) ---
# SESSION__COOKIE_NAME=session
# SESSION__COOKIE_SECURE=false
# SESSION__IDLE_TTL_SECONDS=1209600
# SESSION__ABSOLUTE_TTL_SECONDS=2592000
# SESSION__OPERATION_TIMEOUT_SECONDS=1.0
# Required when APP__ENV=prod:
# SESSION__COOKIE_NAME=__Host-session
# SESSION__COOKIE_SECURE=true

# --- Storage ---
S3_ACCESS_KEY=CHANGE-ME
S3_SECRET_KEY=CHANGE-ME
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Neo4j ---
NEO4J_PASSWORD=CHANGE-ME
NEO4J_WEB_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Apache Kafka ---
KAFKA_PORT=29092

# --- Google ---
GOOGLE__CLIENT_ID=CHANGE-ME
GOOGLE__CLIENT_SECRET=CHANGE-ME

# --- Mail ---
